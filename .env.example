# Google Gemini API key (free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Google Custom Search API for web grounding (free tier 100 queries/day)
# https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Optional: SMTP Email notification settings for price drop alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Optional: Telegram bot notifications for price drop alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
