# Core Server Configuration
PORT=3000

# Google Gemini API (Required for live multi-platform search grounding & AI assistant)
# Model recommendation: gemini-3.8-flash (DO NOT use deprecated 2.5 models)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Custom Google Search Engine
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Flipkart Affiliate API Provider (Optional: connect official Flipkart inventory)
# Register at: https://affiliate.flipkart.com/
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Amazon Product Advertising API (PA-API 5.0) for India (Optional)
# Register at: https://affiliate-program.amazon.in/
AMAZON_PAAPI_KEY=
AMAZON_PAAPI_SECRET=
AMAZON_ASSOCIATE_TAG=
AMAZON_PAAPI_REGION=in

# Price Drop Alerts & Email Notifications (Optional)
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Telegram Price Drop Bot Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
